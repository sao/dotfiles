# Brewfile
# Run: brew bundle --file=Brewfile

# ── Core shell / terminal ──────────────────────────────────────────────────────
brew "zsh"
brew "starship"          # prompt
brew "zsh-syntax-highlighting"
brew "zsh-autosuggestions"
brew "zsh-completions"

# ── File / search ─────────────────────────────────────────────────────────────
brew "ripgrep"           # rg — modern grep
brew "fd"                # modern find
brew "fzf"               # fuzzy finder
brew "bat"               # modern cat with syntax highlighting
brew "eza"               # modern ls
brew "zoxide"            # smarter cd
brew "tree"

# ── Git ───────────────────────────────────────────────────────────────────────
brew "git"
brew "git-delta"         # better git diffs
brew "gh"                # GitHub CLI
brew "lazygit"           # TUI git client

# ── Editors ───────────────────────────────────────────────────────────────────
brew "neovim"

# ── Network / HTTP ────────────────────────────────────────────────────────────
brew "curl"
brew "wget"
brew "httpie"            # modern curl for API testing
brew "jq"                # JSON CLI
brew "yq"                # YAML CLI

# ── Runtime management ────────────────────────────────────────────────────────
brew "uv"                # Python package/env manager
# nvm installed via agent/envs/node.sh (curl, not brew)

# ── Agent / AI tooling ────────────────────────────────────────────────────────
brew "node"              # baseline node for npx/uvx MCP servers

# ── Productivity ──────────────────────────────────────────────────────────────
brew "direnv"            # per-directory env vars

# ── macOS GUI apps ────────────────────────────────────────────────────────────
cask "ghostty"           # terminal emulator
cask "raycast"
