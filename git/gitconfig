[init]
  defaultBranch = main
  templatedir   = ~/.git_template

[push]
  default       = current
  autoSetupRemote = true

[pull]
  rebase        = true

[fetch]
  prune         = true

[rebase]
  autosquash    = true

[merge]
  ff            = only

[diff]
  colorMoved    = zebra
  tool          = vimdiff

[color]
  ui            = auto

[core]
  excludesfile  = ~/.gitignore
  autocrlf      = input
  pager         = delta

[interactive]
  diffFilter    = delta --color-only

[delta]
  navigate      = true
  light         = false
  line-numbers  = true
  side-by-side  = true

[commit]
  template      = ~/.gitmessage

[alias]
  aa  = add --all
  ap  = add --patch
  ci  = commit -v
  co  = checkout
  pf  = push --force-with-lease
  st  = status
  lg  = log --oneline --graph --decorate
  branches = for-each-ref --sort=-committerdate \
    --format="%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)" \
    refs/remotes
  undo = reset --soft HEAD~1
  wip  = !git add -A && git commit -m 'wip [skip ci]'

[include]
  path = ~/.gitconfig.local
